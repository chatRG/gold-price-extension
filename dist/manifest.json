{
  "manifest_version": 3,
  "name": "Gold Price Comparator",
  "version": "1.0.0",
  "description": "Compare gold prices on e-commerce sites with allindiabullion.com rates",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.myntra.com/*",
    "https://*.ajio.com/*",
    "https://allindiabullion.com/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-GGc7Zxc_.js"
      ],
      "matches": [
        "https://*.myntra.com/*",
        "https://*.ajio.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*.ajio.com/*",
        "https://*.myntra.com/*"
      ],
      "resources": [
        "assets/content.ts-GGc7Zxc_.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
