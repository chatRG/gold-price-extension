{
  "manifest_version": 3,
  "name": "Gold Price Comparator",
  "version": "1.2.2",
  "description": "Compare gold prices on e-commerce sites with allindiabullion.com rates",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.myntra.com/*",
    "https://*.ajio.com/*",
    "https://*.flipkart.com/*",
    "https://allindiabullion.com/*"
  ],
  "background": {
    "service_worker": "background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
    "matches": [
      "https://*.myntra.com/*",
      "https://*.ajio.com/*",
      "https://*.flipkart.com/*"
    ],
      "js": ["content/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
