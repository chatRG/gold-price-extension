{
  "manifest_version": 3,
  "name": "Gold Price Comparator",
  "version": "2.0.0",
  "description": "Compare gold jewelry prices on Myntra, Ajio, Flipkart with live market rates",
  "permissions": ["storage"],
  "host_permissions": [
    "https://allindiabullion.com/*"
  ],
  "background": {
    "service_worker": "background/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myntra.com/*",
        "https://*.ajio.com/*",
        "https://*.flipkart.com/*"
      ],
      "js": ["content/content.ts"],
      "run_at": "document_idle"
    }
  ]
}
